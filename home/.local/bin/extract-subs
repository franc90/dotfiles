#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

FILES=$(
  find . -maxdepth 1 -type f | # find files in curr dir
    sed 's|^\.\/||' | # remove './' from beginning
    sort |
    fzf -m --disabled --no-sort --cycle \
        --layout=reverse \
        --preview='bat --style=numbers --color=always {} | head -500'
)

ORIG_IFS=$IFS
IFS=$'\n'
FILES=($FILES) # split to array
IFS=$ORIG_IFS

for FILE in "${FILES[@]}"; do
  filename="${FILE%.*}"
  if [ -d "Subs/$filename" ]; then
      subtitles_dir="Subs/$filename"
  else
      subtitles_dir="Subs"
  fi
  found=$(find "$subtitles_dir" -maxdepth 1 -type f | egrep -e "English" | sort -r | head -n 1)
  echo "found en: $found"
  cp "$found" "$filename.en.srt"
  found=$(find "$subtitles_dir" -maxdepth 1 -type f | egrep -e "Polish" | sort -r | head -n 1)
  echo "found pl: $found"
  cp "$found" "$filename.pl.srt"

done
